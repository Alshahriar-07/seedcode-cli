[TEMPLATE]
# Seed Code CLI - environment configuration example
#
# Copy this file to `.env` and fill in the values you need. `.env` is
# git-ignored and must never be committed.
#
# Any variable set here is also read by the running CLI as an environment
# override for the corresponding stored API key (environment wins over the
# config file; a key you enter in the app wins over the environment).
#
# Keys are provider-scoped: each variable below fills ONLY the provider it
# names. The built-in Default provider never borrows another provider's key.

# --- The built-in Default connection (no user API key required) -------------
# `Default` is Seed Code's own provider and needs no key from you. Release
# artifacts carry an embedded credential; these variables exist so a source
# checkout, CI run, or self-hosted build can supply one instead. Neither
# value is ever written into another provider's stored configuration.
OPENROUTER_API_KEY=

# Optional: a built-in credential for a build that must NOT use the
# OpenRouter variable (checked after OPENROUTER_API_KEY).
SEEDCODE_DEFAULT_API_KEY=

# --- Bring-your-own-key providers -------------------------------------------
# OpenRouter (https://openrouter.ai/keys). Note: this variable configures the
# OpenRouter provider, and is also the first fallback for the built-in
# Default connection above.

# FreeModel (https://freemodel.dev/dashboard) - shared by both FreeModel
# providers (Claude and Codex).
FREEMODEL_API_KEY=

# AeroLink (https://aerolink.lat) - Anthropic-compatible gateway.
AEROLINK_API_KEY=

# Ollama needs no key; its host is configured in the app (`/settings`).

# ---------------------------------------------------------------------------
# First-run selection overrides (optional).
#
# These apply ONLY when there is no stored configuration yet (first run):
# a provider/model you pick inside the app is never overwritten by them.
# SEEDCODE_PROVIDER must be one of: default | openrouter | freemodel_claude |
# freemodel_codex | aerolink | ollama.
SEEDCODE_PROVIDER=default
SEEDCODE_MODEL=cohere/north-mini-code:free
