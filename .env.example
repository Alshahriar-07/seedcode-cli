# Seed Code CLI — environment configuration example
#
# Copy this file to `.env` and fill in the values you need. `.env` is
# git-ignored and must never be committed.
#
# Any variable set here is also read by the running CLI as an environment
# override for the corresponding stored API key (environment wins over the
# config file; a key you enter in the app wins over the environment).

# OpenRouter (https://openrouter.ai/keys) — the default provider catalogue.
OPENROUTER_API_KEY=

# FreeModel (https://freemodel.dev/dashboard) — shared by both FreeModel
# providers (Claude and Codex).
FREEMODEL_API_KEY=

# AeroLink (https://aerolink.lat) — Anthropic-compatible gateway.
AEROLINK_API_KEY=
